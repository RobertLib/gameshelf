{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // URL/URLSearchParams are standard in both the web and Node runtimes; the
    // DOM lib is here only for their types, no DOM API is used in the contracts.
    "lib": ["ES2023", "DOM"],
    "rootDir": "./src",
    "outDir": "./dist/cjs",
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
