# ---------------------------------------------------------------------------
# GameShelf API - configuration
# Copy to apps/api/.env  (`cp apps/api/.env.example apps/api/.env`)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Database -------------------------------------------------------------------
# SQLite: the path is relative to apps/api/prisma/schema.prisma
DATABASE_URL="file:../var/gameshelf.db"
# PostgreSQL (remember to switch `provider` in prisma/schema.prisma):
# DATABASE_URL="postgresql://gameshelf:password@localhost:5432/gameshelf?schema=public"

# Authentication -------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-your-own-random-string-of-at-least-32-chars"
# Access token lifetime in seconds (kept in browser memory only).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (httpOnly cookie, rotated on use). This is an
# IDLE timeout - every use pushes it forward.
REFRESH_TOKEN_TTL_DAYS=30
# The ceiling that renewing cannot push: however actively a session is used, it
# ends after this many days and requires signing in again. Must not be lower
# than REFRESH_TOKEN_TTL_DAYS.
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90
# Turn on once the application is served over HTTPS.
COOKIE_SECURE=false

# Uploaded files -------------------------------------------------------------
# Relative to the API working directory (apps/api), or an absolute path.
UPLOADS_DIR=var/uploads

# Fill the platform and genre lookup tables on startup (idempotent).
SEED_CATALOG_ON_START=true

# Behind a reverse proxy ------------------------------------------------------
# Without this, req.ip is the proxy address, so every visitor shares a single
# bucket for the "per IP" limits. Turning it on where the application is exposed
# directly, on the other hand, means letting the limit be bypassed with a made-up
# X-Forwarded-For header.
#   (empty) = trust nobody, 1 = one proxy, loopback / 10.0.0.0/8 = a range
TRUST_PROXY=

# Frontend -------------------------------------------------------------------
# In production the API serves the built React app itself (one process, one port).
SERVE_WEB=false
WEB_DIST_PATH=../web/dist
# There is no CORS setting: the application is single-origin. In development the
# Vite dev server proxies /api and /uploads to this port, in production this
# process serves the frontend itself.

# Miscellaneous --------------------------------------------------------------
# Swagger UI at /api/docs. Unset: enabled in development, disabled in production.
ENABLE_SWAGGER=true
# Request limits: count / window in seconds
THROTTLE_LIMIT=300
THROTTLE_TTL_SECONDS=60
