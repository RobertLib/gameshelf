node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# A safety net: only .ts/.tsx belong in apps/web/src. A tsc accidentally run
# with emit can dump .js/.d.ts here, and Vite would then prefer them over the
# sources (it resolves .js before .tsx).
apps/web/src/**/*.js
apps/web/src/**/*.d.ts
apps/web/src/**/*.map

# The same for the Vite configuration, and it is even more treacherous: Vite
# looks for vite.config.js BEFORE vite.config.ts, so a forgotten build would
# silently override the source and edits in the .ts would stop taking effect.
apps/web/vite.config.js
apps/web/vite.config.js.map
apps/web/vite.config.d.ts
apps/web/vite.config.d.ts.map

# env
.env
.env.*
!.env.example

# runtime data (sqlite db + uploaded images)
var/
*.db
*.db-journal
*.db-shm
*.db-wal

# prisma generated client
apps/api/prisma/generated/

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
